<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows</TargetFramework>
		<!-- Native AOT -->
		<PublishTrimmed>false</PublishTrimmed>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>false</InvariantGlobalization>
		<_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
		<UseWindowsForms>true</UseWindowsForms>
		<CustomResourceTypesSupport>true</CustomResourceTypesSupport>
		<!-- Icon + Manifest -->
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Asset\Logo.ico</ApplicationIcon>

		<!-- Auto Versioning -->
		<CurrentTime>$([System.DateTime]::Now.ToString("HH.dd.MM.yyyy"))</CurrentTime>
		<Version>$(CurrentTime)</Version>
		<AssemblyVersion>$(CurrentTime)</AssemblyVersion>
		<FileVersion>$(CurrentTime)</FileVersion>
		<AssemblyName>LamToolAutoPhone-$(Version)</AssemblyName>
		<Product>LamToolAutoPhone</Product>
		<Company>LamToolAutoPhone</Company>
		<Copyright>LamToolAutoPhone</Copyright>
		<PackageId>LamToolAutoPhone</PackageId>
		<Title>LamToolAutoPhone</Title>
		<PackageProjectUrl>https://lamtool.net/</PackageProjectUrl>
	</PropertyGroup>
	<ItemGroup>
		<TrimmerRootAssembly Include="System.ComponentModel" />
		<TrimmerRootAssembly Include="System.ComponentModel.TypeConverter" />
		<TrimmerRootAssembly Include="System.Resources.Extensions" />
		<TrimmerRootAssembly Include="System.Drawing.Common" />
	</ItemGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<IsAotCompatible>True</IsAotCompatible>
		<Prefer32Bit>True</Prefer32Bit>
		<PreferNativeArm64>True</PreferNativeArm64>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<IsAotCompatible>True</IsAotCompatible>
		<Prefer32Bit>True</Prefer32Bit>
		<PreferNativeArm64>True</PreferNativeArm64>
	</PropertyGroup>

	<!-- NuGet Packages -->
	<ItemGroup>
		<PackageReference Include="System.Drawing.Common" Version="9.0.0" />
		<PackageReference Include="System.Resources.Extensions" Version="9.0.0" />
		<PackageReference Include="DeviceId.Windows" Version="6.9.0" />
		<PackageReference Include="WinFormsComInterop" Version="0.5.0" />
	</ItemGroup>

	<!-- Project References -->
	<ItemGroup>
		<ProjectReference Include="..\SunnyUI\SunnyUI.csproj" />
		<TrimmerRootAssembly Include="SunnyUI" />
		<ProjectReference Include="..\AutoAndroid\AutoAndroid.csproj" />
		<TrimmerRootAssembly Include="AutoAndroid" />
		<ProjectReference Include="..\Sunny.Subdy.Common\Sunny.Subdy.Common.csproj" />
		<TrimmerRootAssembly Include="Sunny.Subdy.Common" />
		<ProjectReference Include="..\Sunny.Subdy.Server\Sunny.Subdy.Server.csproj" />
		<TrimmerRootAssembly Include="Sunny.Subdy.Server" />
		<ProjectReference Include="..\Sunny.Subdy.Data\Sunny.Subdy.Data.csproj" />
		<TrimmerRootAssembly Include="Sunny.Subdy.Data" />
		<ProjectReference Include="..\Sunny.Subdy.AutoUpdate\Sunny.Subdy.AutoUpdate.csproj" />
		<TrimmerRootAssembly Include="Sunny.Subdy.AutoUpdate" />
		<ProjectReference Include="..\Sunny.Subd.Core\Sunny.Subd.Core.csproj" />
		<TrimmerRootAssembly Include="Sunny.Subd.Core" />
	</ItemGroup>

	<!-- COM Interop -->
	<ItemGroup>
		<COMReference Include="IWshRuntimeLibrary">
			<WrapperTool>tlbimp</WrapperTool>
			<VersionMajor>1</VersionMajor>
			<VersionMinor>0</VersionMinor>
			<Lcid>0</Lcid>
			<Isolated>false</Isolated>
			<EmbedInteropTypes>true</EmbedInteropTypes>
			<Guid>f935dc20-1cf0-11d0-adb9-00c04fd58a0b</Guid>
		</COMReference>
	</ItemGroup>

	<!-- Content -->
	<ItemGroup>
		<Content Include="Assets\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Libs\ffmpeg\**\*.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Libs\Scrcpy\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<Content Include="Asset\Logo.ico" />
	</ItemGroup>

	<!-- Trimming Rules -->
	<ItemGroup>
		<TrimmerRootAssembly Include="System.Drawing.Common" />
		<TrimmerRootAssembly Include="System.Resources.Extensions" />
		<TrimmerRootAssembly Include="mscorlib" />
		<TrimmableAssembly Include="System.Windows.Forms" />
	</ItemGroup>

	

	<!-- AOT Reflection Config -->
	<ItemGroup>
		<RdXmlFile Include="rd.xml" />
		<RdXmlFile Include="Forms.xml" />
	</ItemGroup>

	<Target Name="PreserveReflectionForAutoAndroid" BeforeTargets="PrepareForILLink">
		<ItemGroup>
			<DynamicDependency Include="AutoAndroid.DeviceModel" DynamicallyAccessedMemberTypes="All" />
		</ItemGroup>
	</Target>

	<!-- Optional: workaround for crash in parallel merge sort -->
	<ItemGroup>
		<IlcCompileInput Include="--parallelism:1" />
	</ItemGroup>

</Project>